# Copy to .env.local and fill in. Never commit .env.local.
# With NO Supabase vars the app runs in demo mode (Zustand + localStorage).

# ── Supabase (client-safe) ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key   # public by design; RLS protects data

# ── Supabase (server-only — NEVER prefix with NEXT_PUBLIC_) ─────────────────
# Bypasses RLS. Only used server-side (app/api/invites → inviteUserByEmail).
# Without it, email invites are disabled (the app still works otherwise).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Timeline Estimator
NEXT_PUBLIC_APP_ENV=development

# ── Zoho CRM (server-only — NEVER prefix with NEXT_PUBLIC_) ─────────────────
# From the Zoho API Console (https://api-console.zoho.com) → "Server-based
# Application". The Authorized Redirect URI registered there must EXACTLY match
# ZOHO_REDIRECT_URI below. Without these, the Zoho integration is simply off.
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=https://timeline-estimator-project-manageme.vercel.app/api/zoho/callback
# Optional — override only for non-.com data centers (e.g. https://accounts.zoho.eu):
# ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
# Optional — comma-separated scopes (default below = read-only CRM). Changing this
# ONLY affects the NEXT "Connect" consent — an already-connected workspace keeps
# its current grant until Disconnect → Connect. Whoever clicks Connect must have
# Zoho CRM edit rights on Deals, or the write scopes are requested but useless.
# ZOHO_SCOPES=ZohoCRM.modules.READ,ZohoCRM.users.READ,ZohoCRM.org.READ,ZohoCRM.settings.READ
#
# Phase 3 (docs/zoho-workflow-automation-plan.md) — update Deal fields/stage +
# attach the proposal PDF. Verified against Zoho's own API docs (v8): field/stage
# writes need modules.deals.UPDATE; uploading an attachment needs BOTH the
# module's own write scope (deals.CREATE) AND modules.attachments.CREATE. No
# DELETE scope anywhere — this app can create/update, never remove, a CRM record.
# ZOHO_SCOPES=ZohoCRM.modules.READ,ZohoCRM.users.READ,ZohoCRM.org.READ,ZohoCRM.settings.READ,ZohoCRM.modules.deals.CREATE,ZohoCRM.modules.deals.UPDATE,ZohoCRM.modules.attachments.CREATE
