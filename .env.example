# Copy to .env.local and fill in. Never commit .env.local.
# With NO Supabase vars the app runs in demo mode (Zustand + localStorage).

# ── Supabase (client-safe) ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key   # public by design; RLS protects data

# ── Supabase (server-only — NEVER prefix with NEXT_PUBLIC_) ─────────────────
# Bypasses RLS. Only used server-side (app/api/invites → inviteUserByEmail).
# Without it, email invites are disabled (the app still works otherwise).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Timeline Estimator
NEXT_PUBLIC_APP_ENV=development

# ── Zoho CRM (server-only — NEVER prefix with NEXT_PUBLIC_) ─────────────────
# From the Zoho API Console (https://api-console.zoho.com) → "Server-based
# Application". The Authorized Redirect URI registered there must EXACTLY match
# ZOHO_REDIRECT_URI below. Without these, the Zoho integration is simply off.
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=https://timeline-estimator-project-manageme.vercel.app/api/zoho/callback
# Optional — override only for non-.com data centers (e.g. https://accounts.zoho.eu):
# ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
# Optional — comma-separated OAuth scopes. Omit for the read-only default in
# lib/zoho/config.ts. The set below is what production asks for.
#
# Requested ONCE, deliberately broad: scopes freeze at consent, so every new
# integration would otherwise need an admin (with Zoho edit rights on the
# module) to Disconnect -> Connect again. What this app may actually change is
# enforced in code by lib/zoho/write-allowlist.ts, which today permits exactly
# three writes: create a deal, move a deal's stage, attach a file to a deal.
#
# NOT requested at any tier: any .DELETE scope, ZohoCRM.modules.ALL, or
# settings.ALL. A deleted CRM record has no undo; .ALL includes DELETE.
# (notifications.ALL is the one .ALL here and is safe: it covers webhook
# CHANNELS, not records — unsubscribing needs its delete.)
# ZOHO_SCOPES=ZohoCRM.modules.READ,ZohoCRM.modules.CREATE,ZohoCRM.modules.UPDATE,ZohoCRM.modules.attachments.READ,ZohoCRM.modules.attachments.CREATE,ZohoCRM.settings.READ,ZohoCRM.users.READ,ZohoCRM.org.READ,ZohoCRM.coql.READ,ZohoCRM.bulk.READ,ZohoCRM.notifications.ALL

# ── PBS (billing) API ────────────────────────────────────────────────────────
# Server-only. Credentials come from a one-off POST /api/register against PBS,
# done by hand — this app never registers itself.
#
# PBS_BASE_URL: note this is /api, NOT the /pbs/api the PBS reference doc says.
# Verified 2026-08-26: /pbs/api/* is caught by the PBS session layer and returns
# HTTP 200 with an HTML login redirect, which a res.ok check would sail past.
# PBS_BASE_URL=https://pbsserver.com/api
# PBS_APP_ID=app_xxxxxxxxxxxxxxxx
# PBS_APP_SECRET=...
# OPTIONAL override. Leave unset: PBS project templates are client-scoped (no
# template in 500 POs is shared by two clients), so each PO uses its own client's
# most-used template. Set this only if PBS confirms templates are global, or if a
# dedicated "Web Estimator" template is created for all of them.
# PBS_PROJECT_TEMPLATE_ID=30
#
# Billing client an estimate uses when none is chosen for it. A three-letter
# client CODE (as it appears at the start of a PO number), not a numeric id.
# Resolved against live PO history, so an unknown code simply leaves the picker
# empty rather than failing at create time. Defaults to STR when unset.
# PBS_DEFAULT_CLIENT=STR
